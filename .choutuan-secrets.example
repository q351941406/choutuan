# 复制为 /workspace/.choutuan-secrets (或 $HOME/.config/choutuan/secrets.env), chmod 600, 填真值
# 任一缺失都不影响 init.sh 跑通, 只对应降级为 SKIP (先继续开发, 配好重跑即全量)
TG_API_ID=                  # 协议号三件套之1 (my.telegram.org, 数字)
TG_API_HASH=                # 协议号三件套之2 (32位hex)
TG_STRING_SESSION=          # 协议号三件套之3 (1开头353位, 已授权零短信)
BOT_TOKEN=                  # 测试Bot token (BotFather, 形如 123:ABC)
TEST_CHAT_ID=               # 测试聊天id (e2e.sh 无则自动发现, 配了更快)
